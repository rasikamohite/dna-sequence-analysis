dna_sequence = "ATGCGTACGTTAGC"
print("DNA Sequence:", dna_sequence)

print("Length:", len(dna_sequence))

print("A:", dna_sequence.count("A"))
print("T:", dna_sequence.count("T"))
print("G:", dna_sequence.count("G"))
print("C:", dna_sequence.count("C"))


gc_content = ((dna_sequence.count("G") + dna_sequence.count("C")) / len(dna_sequence)) * 100

print("GC Content:", gc_content, "%")

rna_sequence = dna_sequence.replace("T", "U")

print("RNA Sequence:", rna_sequence)

codon_table = {
    "AUG": "M",
    "UUU": "F", "UUC": "F",
    "UUA": "L", "UUG": "L",
    "UCU": "S", "UCC": "S", "UCA": "S", "UCG": "S",
    "UAU": "Y", "UAC": "Y",
    "UGU": "C", "UGC": "C",
    "UGG": "W",
    "UAA": "*", "UAG": "*", "UGA": "*"
}

protein = ""

for i in range(0, len(rna_sequence) - 2, 3):
    codon = rna_sequence[i:i+3]
    protein += codon_table.get(codon, "?")

print("Protein:", protein)

dna_sequence = dna_sequence.upper().replace(" ", "")

valid_bases = set("ATGC")

if set(dna_sequence).issubset(valid_bases):
    print("Sequence is valid.")
else:
    print("Sequence contains invalid bases.")
